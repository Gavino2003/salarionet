{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/calculadora-salario-liquido", "destination": "/calculadora-salario", "permanent": true },
    { "source": "/salario", "destination": "/calculadora-salario", "permanent": true },
    { "source": "/irs", "destination": "/simulador-irs", "permanent": true },
    { "source": "/imt", "destination": "/calculadora-imt", "permanent": true },
    { "source": "/desemprego", "destination": "/subsidio-desemprego", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
